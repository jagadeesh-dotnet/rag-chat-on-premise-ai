{
    // F5 runs the selected configuration. Needs the "Python Debugger" extension (debugpy).
    // Tests: debug them from the Testing panel (beaker icon), no configuration needed.
    "version": "0.2.0",
    "configurations": [
        {
            // Starts the API under the debugger: breakpoints in backend/app stop here.
            // No --reload (breakpoints are unreliable with it): restart with Ctrl+Shift+F5 after code changes.
            // Set "justMyCode": false to also step into libraries.
            "name": "Backend: FastAPI (debug)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": ["app.main:app", "--port", "8000", "--timeout-graceful-shutdown", "2"],
            "cwd": "${workspaceFolder}/backend",
            "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            // The answer-quality evaluation (report: backend/tests/eval/reports/latest.md).
            // Needs the backend running: start "Backend: FastAPI (debug)" first, then this one.
            "name": "Backend: evaluation",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-m", "eval", "-q"],
            "cwd": "${workspaceFolder}/backend",
            "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
